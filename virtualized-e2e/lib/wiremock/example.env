# Example parameters for rendering the WireMock templates with envsubst:
#
#   set -a; . ./example.env; set +a
#   for f in namespace service deployment; do
#     envsubst < "$f.yaml.tmpl" > "/tmp/$f.yaml"
#   done
#
# The values below are the ones the AWS arm uses; the lib stays generic, so
# future arms can render with their own namespace/Secret/ConfigMap names.

# Namespace that hosts the WireMock Deployment/Service.
WIREMOCK_NAMESPACE=wiremock-system

# Secret holding the JKS keystore and its passwords (keys: wiremock.jks,
# keystore-password, key-manager-password). Created per run from a throwaway
# CA; never committed.
WIREMOCK_KEYSTORE_SECRET=wiremock-keystore

# ConfigMap holding WireMock stub mapping files, mounted at
# /home/wiremock/mappings. Each cloud arm ships its own.
WIREMOCK_STUBS_CONFIGMAP=wiremock-stubs
